# Frontend env. Copy to .env.local for dev; set the same keys in Vercel for prod.
# A chain only appears in the launch UI once its NEXT_PUBLIC_FACTORY_* is set.

# --- Robinhood (chainId 4663) — first mainnet target
NEXT_PUBLIC_FACTORY_4663=
NEXT_PUBLIC_DISTRIBUTOR_4663=

# --- Base (chainId 8453)
NEXT_PUBLIC_FACTORY_8453=
NEXT_PUBLIC_DISTRIBUTOR_8453=

# --- Base Sepolia (chainId 84532) — testnet; also set NEXT_PUBLIC_SHOW_TESTNET=1
NEXT_PUBLIC_FACTORY_84532=
NEXT_PUBLIC_DISTRIBUTOR_84532=
NEXT_PUBLIC_SHOW_TESTNET=

# --- Optional RPC overrides
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_BASE_SEPOLIA_RPC=
NEXT_PUBLIC_ROBINHOOD_RPC=

# --- Registry / submissions (optional in dev, falls back to local mock)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show the holder-rewards claim UI on /launchpad/profile (leave unset until weekly payouts are live)
NEXT_PUBLIC_REWARDS_LIVE=

# Public links (footer/nav). Unset socials are hidden; docs default to the built-in /launchpad/docs page.
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# --- V4 factory (launchpad 1% + founder 0-10% fee). When set, new launches use it and the V3 factory is retired.
NEXT_PUBLIC_FACTORY_V4_4663=
NEXT_PUBLIC_HOOK_4663=
