# contracts/.env — deploy-time secrets. NEVER commit the filled-in .env.
# Use a dedicated deployer account, not your everyday wallet.

DEPLOYER_PRIVATE_KEY=0x____________________________________________________________

# Where the launchpad's 30% of every trading fee lands, plus the per-launch fee.
TREASURY=0xAA3E15AA3e2aeF82acF28fECd83383f9dDC198f0

# Where the holders'/stakers' share accrues between weekly distributions.
# NOTE: this is the pot that funds RewardsDistributor epochs. Setting it equal to
# TREASURY means the holder share and your own share land in one wallet and you
# must fund each weekly epoch out of it by hand.
STAKERS_POOL=0xAA3E15AA3e2aeF82acF28fECd83383f9dDC198f0

# Optional RPC overrides (defaults are the public endpoints in hardhat.config.js)
BASE_RPC=
BASE_SEPOLIA_RPC=
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
